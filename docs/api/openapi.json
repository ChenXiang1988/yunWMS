    "/api/console/roles": {
      "get": {
        "tags": [
          "角色管理"
        ],
        "summary": "分页查询角色",
        "description": "按状态筛选角色，支持按编码或名称模糊匹配，返回每行的占用人数与权限点数量，供管理端角色列表页使用。两个计数由同一条 SQL 聚合得出，前端可以直接用 userCount 判断「该角色还能不能删」而不再发一次请求。筛选条件均可省略，全部省略即返回全量分页；页码从 1 开始，每页条数上限 200，越界返回 40000。",
        "operationId": "page_1",
        "parameters": [
          {
            "name": "pageNo",
            "in": "query",
            "description": "页码，从 1 开始；省略时取 1",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "每页条数，上限 200；省略时取 20，超出上限返回 40000",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "按角色编码或名称模糊匹配的关键词；省略或全空白表示不筛选",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "角色状态：ACTIVE 启用，DISABLED 停用；省略表示全部状态",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "DISABLED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultPageResultRoleListItemResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "角色管理"
        ],
        "summary": "创建角色",
        "description": "新建一个自定义角色并同时写入它勾选的菜单与权限点。三个属性不在请求体里、也不能由调用方指定：新角色一律启用、builtin 恒为 false、数据范围固定 CUSTOM——接口不能创建内置角色，否则等于绕开权限体系造一个超级管理员。角色编码是程序引用角色的标识，格式不合规或已被占用（含已删除的角色，因为唯一索引不带删除条件）返回 40000/40902；勾选的菜单或权限点不存在同样返回 40000。响应只回带标识与编码。",
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
