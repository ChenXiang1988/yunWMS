{
  "openapi": "3.0.1",
  "info": {
    "title": "yunWMS 后端接口",
    "description": "yunWMS 分两端，靠路径前缀区分鉴权主体：`/api/console` 供仓网管理端使用，\n`/api/portal` 供货主端使用；`/api/auth` 由两端共用，登录的主体类型由后端按账号判定，\n调用方不传也不允许传。\n\n除未认证（401）、无权限（403）与服务内部错误（500）外，所有接口一律返回 HTTP 200，\n业务结果由响应体 `ApiResult` 的 `code` 表达（0 表示成功，非 0 见错误码表）。\n这三类通用响应在 `components.responses` 中统一声明，各接口直接引用，不再重复描述。\n",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:18087",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "角色管理",
      "description": "仓网端的角色管理：建、读、改、启停、删在这里闭环。角色是授权数据的来源，能改角色就等于能给自己加权限，因此全部接口都要求权限点而不是只要求登录。货主端没有角色管理能力，权限由管理员在这里配置。"
    },
    {
      "name": "认证",
      "description": "两端共用的登录与本人改密入口。登录时的主体类型（内部员工或货主账号）由后端按账号判定，调用方不传也不允许传。"
    },
    {
      "name": "用户管理",
      "description": "仓网端的账号管理：建号、查询、编辑基本信息、启停、重置密码与分配角色。货主端没有建号能力，货主账号由管理员在这里开通。全部接口都要求对应权限点，只登录但没有权限点的账号会拿到 403。"
    }
  ],
  "paths": {
    "/api/console/users/{id}": {
      "get": {
        "tags": [
          "用户管理"
        ],
        "summary": "查询用户详情",
        "description": "取单个账号的完整信息：列表行里已有的字段之外，再带出邮箱、企业微信 userid、用户级数据范围覆盖值与用于回填编辑表单的角色标识（roleIds）。角色编码与角色标识两种表示同时返回，前端保存后刷新详情时不必再发一次列表请求。账号不存在或已被逻辑删除返回 40400。",
        "operationId": "detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "用户标识，取自列表或详情响应里的 id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultUserDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "tags": [
          "用户管理"
        ],
        "summary": "编辑用户基本信息",
        "description": "全量替换展示名、邮箱与企业微信 userid：字段传 null 表示清空，不传表示按 null 处理，即调用方必须提交自己希望保留的全部值。登录名、主体类型与所属货主不在可编辑范围内——它们决定账号身份与数据归属，改动属于另一件事（换账号或迁移归属），因此请求体里没有这些字段，多传会被拒绝而不是静默忽略。内部员工清空邮箱返回 40000，邮箱被他人占用返回 40903，账号不存在返回 40400。成功后不回带详情，需要最新值时重新取。",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "用户标识，取自列表或详情响应里的 id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/console/users/{id}/status": {
      "put": {
        "tags": [
          "用户管理"
        ],
        "summary": "启用或停用用户账号",
        "description": "切换账号状态。停用立即生效：该账号的既有会话随即失效，且无法再次登录，不必等令牌过期。目标状态与当前状态相同时返回成功，不报错——重复提交同一次启停是正常的重放。两条业务保护：不能停用自己，也不能停用最后一个可用的超级管理员（返回 40900），否则系统会失去唯一能配置权限的账号。账号不存在返回 40400。",
        "operationId": "changeStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "用户标识，取自列表或详情响应里的 id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeUserStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/console/users/{id}/roles": {
      "put": {
        "tags": [
          "用户管理"
        ],
        "summary": "分配用户角色（整批替换）",
        "description": "把账号的角色集合整体替换为提交的这一组：请求体里的 roleIds 就是这个人之后拥有的全部角色，空数组表示移除全部角色。先删后插在同一个事务里完成，不会出现「删掉了但没插进去」的中间态，因此重复提交同一组角色是幂等的。这是唯一会改变「谁能做什么」的入口，权限点不可与其他写操作共用。被拒绝的情形：用户不存在（40400）、请求里有不存在或已删除的角色（40000）、操作人把自己替换成不含内置角色的组合（40900，否则系统可能不再有能配置权限的账号）。成功后不回带角色列表，需要最新值时重新取详情。",
        "operationId": "assignRoles",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "用户标识，取自列表或详情响应里的 id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRolesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/console/users/{id}/password": {
      "put": {
        "tags": [
          "用户管理"
        ],
        "summary": "重置他人密码",
        "description": "管理员为指定账号设置新密码，不校验旧密码，用于员工忘记密码的情形。正因为不验旧密码，它不能作用于调用者自己（返回 40900）——否则这就是一条绕过旧密码校验的通道，改自己的密码请走 PUT /api/auth/password。成功后该账号的全部会话立即失效，并重新标记为「首次登录必须改密」，下次登录只能先改密。新密码不满足策略时一次返回全部违规项（40000），账号不存在返回 40400；新密码不回显，响应无业务数据。",
        "operationId": "resetPassword",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "被重置密码的用户标识，不能是当前登录账号",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetUserPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/console/roles/{id}": {
      "get": {
        "tags": [
          "角色管理"
        ],
        "summary": "查询角色详情",
        "description": "取单个角色的完整信息：列表行已有的字段之外，再带出该角色已勾选的菜单与权限点标识，供授权配置页回显勾选状态。menuIds 同时含菜单（C）与操作（F）两级——只回操作级会让菜单节点无法回显。角色不存在或已被逻辑删除返回 40400。",
        "operationId": "detail_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "角色标识，取自列表响应里的 id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultRoleDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "tags": [
          "角色管理"
        ],
        "summary": "编辑角色",
        "description": "全量替换角色名称、备注与授权：menuIds 提交的就是这个角色之后拥有的全部权限点，空数组表示清空全部授权，名称与授权在同一个事务里落库，不存在只改了一半的中间态。编码不在可编辑范围内——配置与代码按编码引用角色，改了等于换一个角色，因此多传 code 会被拒绝而不是静默忽略。内置角色不可编辑（40900）；角色不存在返回 40400，名称为空或菜单不存在返回 40000。成功后不回带详情。",
        "operationId": "update_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "角色标识，取自列表响应里的 id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "角色管理"
        ],
        "summary": "删除角色",
        "description": "删除一个自定义角色，采用软删除（库里留 deleted_at），与账号的删除模式一致，将来审计日志里的角色编码才对得上真实对象；删除后列表与详情立即查不到它。仍被用户占用的角色一律拒绝并在提示里带出占用人数（40900）：关联表是级联删除，少了这道校验，删除会静默带走关联记录，那些用户会静默失去该角色带来的权限。内置角色不可删除（40900），角色不存在返回 40400。副作用需提前知道：角色编码的唯一索引不带删除条件，删除后该编码仍被占用，重建同名角色会被拒绝。成功后不回带被删对象。",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "角色标识，取自列表响应里的 id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/console/roles/{id}/status": {
      "put": {
        "tags": [
          "角色管理"
        ],
        "summary": "启用或停用角色",
        "description": "切换角色状态。停用立即生效：鉴权侧每次请求都按角色状态过滤，持有该角色的用户下一次请求就不再拥有它带来的权限点，不必等会话过期；启用同样立即恢复。目标状态与当前状态相同时返回成功，不报错。内置角色不可停用（40900）——停完之后没有任何账号能配置权限，而界面上没有恢复入口。角色不存在返回 40400。",
        "operationId": "changeStatus_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "角色标识，取自列表响应里的 id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRoleStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/auth/password": {
      "put": {
        "tags": [
          "认证"
        ],
        "summary": "修改本人密码",
        "description": "已登录用户修改自己的密码，是「待改密」状态下唯一被放行的业务接口：用初始密码或管理员重置的密码登录后，其他接口一律返回 40104，必须先走这里，否则该账号既改不了密也用不了系统。只要求登录、不要求权限点——这是每个人维护自己凭据的入口，加权限点会让新账号卡在第一步。判定顺序为：锁定期（40103）→ 旧密码（40101）→ 新密码策略（40000），先验旧密码是为了不把口令策略细节透露给持有待改密令牌的人。成功后清空「需改密」标记与失败计数，并让该账号的其他会话失效；当前会话继续可用。",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/console/users": {
      "get": {
        "tags": [
          "用户管理"
        ],
        "summary": "分页查询用户账号",
        "description": "按主体类型与状态筛选账号，支持按登录名或姓名模糊匹配，返回每行的角色编码与所属货主名称，供管理端列表页使用。角色与货主由固定条数的查询随行带出，前端不必再逐个用户查一次。所有筛选条件都可省略，全部省略即返回全量分页；页码从 1 开始，每页条数上限 200，越界返回 40000 而不是静默截断。",
        "operationId": "page",
        "parameters": [
          {
            "name": "pageNo",
            "in": "query",
            "description": "页码，从 1 开始；省略时取 1",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "每页条数，上限 200；省略时取 20，超出上限返回 40000",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "subjectType",
            "in": "query",
            "description": "主体类型：STAFF 内部员工，OWNER 货主用户；省略表示全部主体",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "STAFF",
                "OWNER"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "账号状态：ACTIVE 启用，DISABLED 停用；省略表示全部状态",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "DISABLED"
              ]
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "按登录名或展示名模糊匹配的关键词；省略或全空白表示不筛选",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultPageResultUserListItemResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "用户管理"
        ],
        "summary": "创建用户账号",
        "description": "由管理员开通一个账号，供内部员工或货主用户登录。新账号一律启用，初始密码由管理员给出，并标记为「首次登录必须改密」：登录后除改密外调不到任何业务接口。主体与货主必须匹配——货主账号要带 ownerId，内部员工必须不传；内部员工还必须留邮箱，用于自助找回密码。登录名与邮箱都全局唯一，被占用分别返回 40901、40903，密码不满足策略返回 40000。响应只回带标识与登录名，口令不回显。",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
