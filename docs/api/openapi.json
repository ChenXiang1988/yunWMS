                  "$ref": "#/components/schemas/ApiResultCreatedRoleResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "账号密码登录，签发会话令牌",
        "description": "用登录名与密码换取令牌及本次登录的权限上下文。这是唯一免鉴权的业务入口：拿不到第一张令牌就无从调用其他接口，因此不要求登录。凭据错误统一返回 40101（不区分登录名不存在与密码错误），账号停用返回 40102，连续失败命中锁定返回 40103。登录不区分两端，主体类型由后端判定。成功后返回令牌、可进入的前端应用与是否需要先改密；mustChangePassword 为 true 时前端应直接进改密页，其余业务接口会返回 40104。",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultLoginResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
