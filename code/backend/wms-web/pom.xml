<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yunwms</groupId>
        <artifactId>wms-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>wms-web</artifactId>
    <name>wms-web</name>
    <description>入站协议层的共用物：统一响应、错误码、业务异常、全局异常处理、分页结构。不依赖任何业务模块。</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          契约注解。仅编译期，无运行时体积。

          为什么 wms-web 也要显式声明：ApiResult 与 PageResult 是本层对外暴露的类型，
          它们的字段描述属于契约的一部分，写在这里才是唯一权威。靠 wms-app 的 springdoc
          传递进来属于「偶然可用」——wms-web 单独编译时就会缺注解。
        -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
    </dependencies>
</project>
