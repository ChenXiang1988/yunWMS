<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.yunwms</groupId>
    <artifactId>wms-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>yunWMS backend</name>

    <modules>
        <module>wms-web</module>
        <module>wms-auth</module>
        <module>wms-master</module>
        <module>wms-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <sa-token.version>1.46.0</sa-token.version>
        <springdoc.version>2.7.0</springdoc.version>
        <!--
            OpenAPI 注解的版本，必须跟着 springdoc-openapi-starter-webmvc-ui:2.7.0 实际传递的版本走，
            不单独挑版本：注解与 swagger-core 的模型类由同一套 jar 发布，两边版本错开时
            springdoc 解析出来的文档结构会与注解语义不一致，而这类偏差不会在编译期报错。
            取值来源：./mvnw dependency:tree -pl wms-app -Dincludes=io.swagger.core.v3
        -->
        <swagger-annotations.version>2.2.25</swagger-annotations.version>
        <!--
            模块边界检查依赖。放在父 pom 统一管理，子模块只声明坐标不写版本，
            避免多个模块各自钉版本后漂移出「同一份代码在不同模块跑出不同结论」。
        -->
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.yunwms</groupId>
                <artifactId>wms-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yunwms</groupId>
                <artifactId>wms-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yunwms</groupId>
                <artifactId>wms-master</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
                数据权限插件（DataPermissionInterceptor / MultiDataPermissionHandler）所在的构件。
                MyBatis-Plus 3.5.9 起，依赖 JSqlParser 的插件（数据权限、多租户、攻击 SQL 阻断等）
                从 mybatis-plus-extension 拆到了这里，不引入它只在运行期报 ClassNotFound，编译期无声。

                版本跟 ${mybatis-plus.version} 走，不单独钉：插件与核心按同一份拦截器契约发布，
                两边错开版本不会编译失败，只会在运行期把 SQL 改错——那类错误只能靠集成测试发现。

                许可证 Apache-2.0，与既有 MyBatis-Plus 同源；它自己传递引入 JSqlParser 5.0
                （LGPL-2.1 / Apache-2.0 双许可，按 Apache-2.0 使用）。
                不引入第二套 SQL 解析库：全仓的 SQL 改写只走这一个解析器。
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!--
                只有 wms-app 能靠 springdoc 的传递依赖拿到这组注解，wms-auth 的 Controller 与 DTO
                要写 @Tag / @Operation / @Schema 就必须自己声明。由父 pom 统一管版本，
                避免注解与 springdoc 传递的那份版本漂移。
            -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>
            <!--
                ArchUnit 的 JUnit 5 集成（api + engine 的聚合 pom）。
                版本由父 pom 统一管，子模块不写版本号。
            -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                依赖准入的构建期执行点，决策见 openspec/changes/2026-10-29-enforce-dependency-guard/design.md 的 D1。
                AGENTS.md「禁止引入 GPL/AGPL/SSPL 依赖」与 openspec/config.yaml 的同名约束此前只活在文档里：
                往任一 pom 加一个依赖不会让构建变红，只能靠 review 发现。这里把它变成 validate 阶段的硬失败。

                放在父 pom 的 <build><plugins>：父 pom packaging=pom，插件会继承到 wms-web/auth/master/app，
                各模块不必重复声明，也就不会出现「某个模块忘了带门禁」。绑 validate 而不是 package，
                是为了在 compile / test / verify 之前就失败——否则 ArchUnit 与 Testcontainers 会先跑一轮，
                报错离真正的原因隔了十几个阶段。

                诚实边界：bannedDependencies 按「坐标」匹配，Maven 的依赖元数据里没有许可证字段可供判定，
                所以它挡不住一个从未被点名过的 AGPL 库。这一层由同一个 change 的准入清单兜底
                （任何新依赖必须先登记，登记即触发 AGENTS.md 的准入三问）。
                加了 enforcer 不等于许可证安全，别把这两件事当成一件事。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <!--
                    版本写死，不吃 Spring Boot parent 的 pluginManagement：规则语义随插件版本变化，
                    跟 parent 走等于把门禁的行为交给「升级 Spring Boot 的那次提交」顺带决定，
                    而那次提交的评审目标是框架升级，没人会看门禁。
                -->
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>dependency-guard</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!--
                                    「同一份代码在不同 JDK 上跑出不同结论」比编译失败更难查：
                                    record 模式、虚拟线程、switch 模式匹配都在 21 才定稿，
                                    低版本上要么编译不过、要么换了语义却照样通过。
                                -->
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <!--
                                    下限取 wrapper 实测版本（.mvn/wrapper/maven-wrapper.properties 里的 3.9.9），
                                    不是随手写的整数：profile 激活与依赖仲裁的行为随 Maven 版本变化，
                                    钉住它才能让本机与 CI 得到同一棵依赖树。
                                -->
                                <requireMavenVersion>
                                    <version>[3.9.9,)</version>
                                </requireMavenVersion>
                                <!--
                                    黑名单每条只写「为什么禁」——坐标本身已经说明了禁的是什么。
                                    searchTransitive=true：被点名的库往往不是自己加的，而是跟着某个 starter 进来；
                                    只查直接依赖等于锁了正门、后门敞开。
                                -->
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!--
                                            XXL-Job：AGPL 家族，AGENTS.md 禁止项与 config.yaml 许可约束点名。
                                            默认零商业授权预算下，AGPL 的闭源分发义务无法接受；
                                            本仓库当前也没有分布式调度的真实需求，不因「以后可能要」先引入。
                                        -->
                                        <exclude>com.xuxueli:*</exclude>
                                        <!--
                                            JeeWMS：AGPL，config.yaml 点名禁止的同类完整 WMS。
                                            它的领域模型与本项目不兼容，不存在「只借鉴一个模块」的引入路径，
                                            整体引入等于把别人的模型塞进我们的库表。
                                        -->
                                        <exclude>*:jee-wms*</exclude>
                                        <exclude>*:jeewms*</exclude>
                                        <exclude>com.jeewms:*</exclude>
                                        <exclude>org.jeewms:*</exclude>
                                        <!--
                                            MySQL 驱动：GPL 双许可，商用分发需向 Oracle 采购商业许可，
                                            与「默认零商业授权预算」直接冲突，config.yaml 点名禁止。
                                            持久层固定 PostgreSQL，没有需要 MySQL 兼容的部署形态。
                                        -->
                                        <exclude>com.mysql:*</exclude>
                                        <exclude>mysql:*</exclude>
                                        <!--
                                            内嵌 Redis：会在测试期下载并拉起真实的 Redis 服务端二进制，
                                            等于把「Redis 7.4+ 不得引入」这条部署约束绕进了构建——
                                            构建机上跑的到底是哪个服务端版本将无人负责，也无从审计。
                                            测试需要 Redis 时连 docker-compose.dev.yml 的 Valkey 8，
                                            或用 Testcontainers 显式声明镜像版本，而不是用内嵌实现。
                                        -->
                                        <exclude>*:embedded-redis*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
