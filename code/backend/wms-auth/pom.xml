<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yunwms</groupId>
        <artifactId>wms-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>wms-auth</artifactId>
    <name>wms-auth</name>
    <description>认证、会话、用户、角色、权限点、数据范围。</description>

    <dependencies>
        <dependency>
            <groupId>com.yunwms</groupId>
            <artifactId>wms-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!--
            数据权限插件（DataPermissionInterceptor）与 JSqlParser。拦截器在本模块装配，
            由它改写 wms-master 的 Mapper 语句，因此解析器必须在本模块的 classpath 上，
            而不是靠启动模块偶然带上。版本由父 pom 统一管理。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <!--
            会话存储用的 Redis 协议客户端。依赖名带 redis、与 config.yaml「Redis 7.4+ 禁止」表观冲突，
            所以这里把边界写清楚：服务端是 Valkey 8（code/backend/docker-compose.dev.yml 的
            valkey/valkey:8-alpine），本依赖只是 Spring 侧的协议客户端（Lettuce，Apache-2.0），
            不含任何服务端二进制，不构成「引入 Redis 服务端」——那条约束管的是部署的服务端版本，
            不是客户端协议库，两者不冲突。

            会话侧只写 String、基本类型包装类与时间，不存领域对象
            （依据 com.yunwms.auth.infrastructure.security.SessionAttributes 的类注释），
            因此将来换存储实现不用迁领域模型，序列化方式也不会绑死在某个实现上。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
            OpenAPI 注解（@Tag / @Operation / @Parameter / @Schema）。没有它，接口与 DTO 的描述只能是
            代码注释，生成的 /v3/api-docs 里字段说明全是空。版本由父 pom 的 dependencyManagement 管理，
            此处不写版本号，也不跟随 springdoc 的传递依赖——传递依赖随时可能因 wms-app 的引入方式变化而消失。
        -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
